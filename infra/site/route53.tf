resource "aws_route53_zone" "website" {
  comment                     = "HostedZone created by Route53 Registrar"
  enable_accelerated_recovery = false
  name                        = var.domain_name

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_route53_record" "apex" {
  name    = var.domain_name
  type    = "A"
  zone_id = aws_route53_zone.website.zone_id
  alias {
    evaluate_target_health = false
    name                   = aws_cloudfront_distribution.website.domain_name
    zone_id                = aws_cloudfront_distribution.website.hosted_zone_id
  }
}

resource "aws_route53_record" "www" {
  name    = "www.${var.domain_name}"
  type    = "A"
  zone_id = aws_route53_zone.website.zone_id
  alias {
    evaluate_target_health = false
    name                   = aws_cloudfront_distribution.website.domain_name
    zone_id                = aws_cloudfront_distribution.website.hosted_zone_id
  }
}

resource "aws_route53_record" "wildcard" {
  name    = "*.${var.domain_name}"
  type    = "A"
  zone_id = aws_route53_zone.website.zone_id
  alias {
    evaluate_target_health = false
    name                   = aws_cloudfront_distribution.website.domain_name
    zone_id                = aws_cloudfront_distribution.website.hosted_zone_id
  }
}

# ACM DNS validation records. Values are generated by ACM and must match
# aws_acm_certificate.website.domain_validation_options exactly.
resource "aws_route53_record" "cert_validation_apex" {
  name    = "_23a2458e5b13cab0ec11a2a3c10c398a.oladayoayorinde.com"
  records = ["_7ada29c7680b2256305c697f62576140.xlfgrmvvlj.acm-validations.aws."]
  ttl     = 300
  type    = "CNAME"
  zone_id = aws_route53_zone.website.zone_id
}

resource "aws_route53_record" "cert_validation_www" {
  name    = "_87fa2718e4093d4a931711a37fe5cf78.www.oladayoayorinde.com"
  records = ["_970fedd0494916fa1166433ff1e30d9f.xlfgrmvvlj.acm-validations.aws."]
  ttl     = 300
